@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Create";
}

<h1 class="mb-4">Cadastrar Nova Central de Custo</h1>
<div class="row">
    <div class="col-md-6">
        <form action="/CentralDeCusto/Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="NomeCentral" class="form-label">Nome da Central</label>
                <input type="text" id="NomeCentral" name="NomeCentral" class="form-control" />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/CentralDeCusto/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div></div>