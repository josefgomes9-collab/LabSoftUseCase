@model IEnumerable<AppTask.Models.CentralDeCusto>

@{
    ViewData["Title"] = "Index";
}

<h1 class="mb-4">Lista de Centrais de Custo</h1>

<p>
    <a href="/CentralDeCusto/Create" class="btn btn-success text-white">Novo</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome da Central</th>
            <th>Valor da Meta Anual</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NomeCentral</td>
                <td>@item.ValorMetaAnual</td>
                <td>
                    <a href="/CentralDeCusto/Edit/@item.Codigo" class="btn btn-primary btn-sm text-white">Alterar</a>
                    <a href="/CentralDeCusto/Details/@item.Codigo" class="btn btn-success btn-sm text-white" style="background-color: #006400;">Detalhe</a>
                    <button type="button" class="btn btn-danger btn-sm text-white"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-nome="@item.NomeCentral">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmação de Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a central de custo: <strong id="itemIdentificacao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="modal-btn-cancel btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <!-- Formulário que dispara o POST de Delete para a Controller -->
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Captura o evento de abertura do modal e preenche os dados dinamicamente
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var nome = button.getAttribute('data-nome');

            var modalSpan = deleteModal.querySelector('#itemIdentificacao');
            modalSpan.textContent = nome;

            var deleteForm = deleteModal.querySelector('#deleteForm');
            deleteForm.action = '/CentralDeCusto/Delete/' + id;
        });
    </script>
}